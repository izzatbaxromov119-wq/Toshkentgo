# Bu fayl "backend/.env" nomi bilan nusxalanadi (run.py buni o'zi qiladi).
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-qator-yozing
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Baza: sqlite (standart, hech narsa o'rnatish shart emas) yoki postgres
DB_ENGINE=sqlite

# --- PostgreSQL ishlatmoqchi bo'lsangiz: DB_ENGINE=postgres qiling va pastdagilarni to'ldiring ---
DB_NAME=tashkentgo
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# React (Vite) ishlaydigan manzil
FRONTEND_URL=http://localhost:5173
